# Google Gemini API Key
# 請到 https://ai.google.dev/ 獲取您的 API Key
GEMINI_API_KEY=your_api_key_here

# （選填）覆寫 Gemini 模型 ID — 模型下架/升級時無需改版即可切換
# 未設定時使用 AppConstants 預設（gemini-3.6-flash / gemini-3.1-pro-preview）
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=

# FastAPI 後端位址（表單結構分析 / 原格式回填 / 法規標準判定）
# ⚠️ 實機建置必填：未設定時會退回 http://localhost:8000，
#    在手機上必然連線失敗，後端相關功能（回填/雲端判定）會降級。
# 本機開發（模擬器）：Android emulator 用 http://10.0.2.2:8000
BACKEND_API_URL=https://your-backend.run.app

# 後端 API 存取金鑰（後端有設 BACKEND_API_KEY 時必填，隨請求以 X-API-Key 送出）
BACKEND_API_KEY=

# Cloud Run API Gateways（舊版雲端同步架構，目前核心流程未使用）
# 若三者皆相同，可僅填 CLOUD_RUN_BASE_URL
CLOUD_RUN_BASE_URL=
CLOUD_RUN_AUTH_URL=
CLOUD_RUN_TASK_URL=
CLOUD_RUN_UPLOAD_URL=
